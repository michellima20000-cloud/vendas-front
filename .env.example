NEXT_PUBLIC_API_URL=https://vendas-black.onrender.com/api/v1

# Upstash Redis (usado só no servidor: cache do catálogo)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
